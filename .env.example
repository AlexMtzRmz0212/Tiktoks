# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required ---------------------------------------------------------------
# Postgres with the pgvector extension available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Where the generated Obsidian notes go (the vault folder, or a subfolder of it).
VAULT_PATH=vault

# --- Inputs / working dirs (relative paths are relative to this repo) -------
FAVORITES_CSV=data/favorites.csv
MEDIA_DIR=data/media

# --- Stage 2: transcripts -----------------------------------------------------
# Caption track preference (prefix match on the track's language code), in order.
CAPTION_LANGS=eng,en,spa,es
WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
WHISPER_DEVICE=auto
# int8_float16 on GPU, int8 on CPU. Leave empty to pick automatically.
WHISPER_COMPUTE_TYPE=
# Optional: browser to borrow TikTok cookies from for login/age-gated videos
# (e.g. chrome, firefox, edge). Leave empty to not use cookies.
YTDLP_COOKIES_FROM_BROWSER=

# --- Stages 3 + 5: local embeddings (search and categories) --------------------
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda
EMBEDDING_DEVICE=cpu

# --- Links between notes ----------------------------------------------------
# Each note links to up to RELATED_MAX other videos whose text is at least this similar (0 to 1).
# Lower the similarity for more links, raise it for fewer, closer ones.
RELATED_MAX=5
RELATED_MIN_SIMILARITY=0.52

# Search by meaning ignores videos scoring below this against the query (0 to 1).
SEARCH_MIN_SIMILARITY=0.45

# Topics: videos are grouped when their texts are on average at least this similar (0 to 1), and
# a group needs at least TOPIC_MIN_SIZE videos to become a topic. Check the preview before applying.
TOPIC_SIMILARITY=0.50
TOPIC_MIN_SIZE=4

# Long transcripts (over ~2000 characters) also get a fingerprint per part of about CHUNK_CHARS
# characters (at most CHUNK_MAX parts), so search can find one idea inside a long video. 0 turns it off.
CHUNK_CHARS=800
CHUNK_MAX=8

# --- Pipeline -----------------------------------------------------------------
MAX_ATTEMPTS=3
