# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required ---------------------------------------------------------------
# Postgres with the pgvector extension available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
ANTHROPIC_API_KEY=

# Where the generated Obsidian notes go (the vault folder, or a subfolder of it).
VAULT_PATH=vault

# --- Inputs / working dirs (relative paths are relative to this repo) -------
FAVORITES_CSV=data/favorites.csv
MEDIA_DIR=data/media

# --- Stage 3: Claude ----------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high  (summaries + classification do fine on low)
ANTHROPIC_EFFORT=low
# Language for titles, summaries, key points and tags.
NOTES_LANGUAGE=English

# --- Stage 2: transcripts -----------------------------------------------------
# Caption track preference (prefix match on the track's language code), in order.
CAPTION_LANGS=eng,en,spa,es
WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
WHISPER_DEVICE=auto
# int8_float16 on GPU, int8 on CPU. Leave empty to pick automatically.
WHISPER_COMPUTE_TYPE=
# Optional: browser to borrow TikTok cookies from for login/age-gated videos
# (e.g. chrome, firefox, edge). Leave empty to not use cookies.
YTDLP_COOKIES_FROM_BROWSER=

# --- Stage 5: embeddings ------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda
EMBEDDING_DEVICE=cpu

# --- Pipeline -----------------------------------------------------------------
MAX_ATTEMPTS=3
